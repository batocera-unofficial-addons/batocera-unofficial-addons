#!/bin/bash

STOP_FILE="/tmp/wayvnc_headless.stop"
LOG_FILE="/userdata/system/logs/wayvnc_headless.log"
SWAY_LOG="/tmp/sway_headless.log"
# PID of the headless sway this service started. Only that sway is ever
# stopped, so a desktop sway session on the same machine keeps running.
SWAY_PID_FILE="/tmp/wayvnc_headless_sway.pid"
WAYVNC_BIN="/usr/bin/wayvnc"
RUN_CMD="$WAYVNC_BIN 0.0.0.0"
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

export WLR_BACKENDS=headless
export WLR_LIBINPUT_NO_DEVICES=1
export LD_LIBRARY_PATH="/userdata/system/add-ons/wayvnc/lib:$LD_LIBRARY_PATH"

# Stops the headless sway this service started, if it is still running.
stop_our_sway() {
    local pid
    pid=$(cat "$SWAY_PID_FILE" 2>/dev/null)
    if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "sway" ]; then
        kill "$pid" 2>/dev/null
        for _ in 1 2 3 4 5; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 1
        done
        kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$SWAY_PID_FILE"
}

# Prints the Wayland sockets in XDG_RUNTIME_DIR, one per line.
list_sockets() {
    local s
    for s in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$s" ] && echo "$s"
    done
}

case "$1" in
    start)
        # Wait until wayvnc is installed and executable
        while [ ! -x "$WAYVNC_BIN" ]; do
            echo "$(date) Waiting for $WAYVNC_BIN to appear..." >> "$LOG_FILE"
            sleep 1
        done

        [ -f "$STOP_FILE" ] && rm "$STOP_FILE"

        # Already running (or the normal WayVNC service holds port 5900)
        if pgrep -f "$RUN_CMD" > /dev/null; then
            echo "$(date) wayvnc is already running, not starting another." | tee -a "$LOG_FILE"
            exit 0
        fi

        (
            while [ ! -f "$STOP_FILE" ]; do
                stop_our_sway
                echo "$(date) Starting headless sway..." | tee -a "$LOG_FILE"

                # Sockets that exist before our sway starts belong to other
                # sessions; ours is the one that appears afterwards.
                before=$(list_sockets)
                sway > "$SWAY_LOG" 2>&1 &
                sway_pid=$!
                echo "$sway_pid" > "$SWAY_PID_FILE"

                socket=""
                for _ in {1..10}; do
                    while IFS= read -r s; do
                        grep -qxF "$s" <<< "$before" || { socket="$s"; break; }
                    done < <(list_sockets)
                    [ -n "$socket" ] && break
                    kill -0 "$sway_pid" 2>/dev/null || break
                    sleep 1
                done

                if [ -z "$socket" ]; then
                    echo "$(date) Sway failed to start, log:" | tee -a "$LOG_FILE"
                    cat "$SWAY_LOG" >> "$LOG_FILE"
                    stop_our_sway
                    sleep 5
                    continue
                fi
                export WAYLAND_DISPLAY="${socket##*/}"

                while [ ! -f "$STOP_FILE" ] && kill -0 "$sway_pid" 2>/dev/null && [ -S "$socket" ]; do
                    echo "$(date) Starting wayvnc headless with $WAYLAND_DISPLAY..." | tee -a "$LOG_FILE"
                    $RUN_CMD >> "$LOG_FILE" 2>&1
                    echo "$(date) wayvnc headless exited. Restarting..." | tee -a "$LOG_FILE"
                    sleep 2
                done
            done

            stop_our_sway
            echo "$(date) Stop file found. Exiting wayvnc headless service." | tee -a "$LOG_FILE"
        ) &
        ;;
    stop)
        echo "$(date) Stopping wayvnc headless..." | tee -a "$LOG_FILE"
        touch "$STOP_FILE"
        pkill -f "$RUN_CMD"
        stop_our_sway
        ;;
    status)
        if pgrep -f "$RUN_CMD" > /dev/null; then
            echo "wayvnc headless is running."
        else
            echo "wayvnc headless is not running."
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac

exit 0
