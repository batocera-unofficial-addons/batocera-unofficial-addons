<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080">
  <defs>
    <!-- Star field tile -->
    <pattern id="stars" x="0" y="0" width="480" height="270" patternUnits="userSpaceOnUse">
      <circle cx="43"  cy="22"  r="1.3" fill="white" opacity="0.75"/>
      <circle cx="120" cy="87"  r="0.8" fill="white" opacity="0.45"/>
      <circle cx="198" cy="14"  r="1.6" fill="white" opacity="0.6"/>
      <circle cx="276" cy="60"  r="0.9" fill="white" opacity="0.65"/>
      <circle cx="380" cy="35"  r="1.1" fill="white" opacity="0.5"/>
      <circle cx="52"  cy="148" r="0.8" fill="white" opacity="0.35"/>
      <circle cx="160" cy="200" r="1.4" fill="white" opacity="0.7"/>
      <circle cx="315" cy="165" r="0.7" fill="white" opacity="0.4"/>
      <circle cx="430" cy="220" r="1.0" fill="white" opacity="0.55"/>
      <circle cx="90"  cy="255" r="1.2" fill="white" opacity="0.5"/>
      <circle cx="240" cy="238" r="0.8" fill="white" opacity="0.3"/>
      <circle cx="460" cy="145" r="1.3" fill="white" opacity="0.65"/>
      <circle cx="350" cy="248" r="0.9" fill="white" opacity="0.5"/>
      <circle cx="10"  cy="190" r="1.0" fill="white" opacity="0.4"/>
      <circle cx="470" cy="70"  r="0.7" fill="white" opacity="0.55"/>
      <circle cx="205" cy="118" r="1.1" fill="white" opacity="0.35"/>
      <circle cx="330" cy="100" r="0.8" fill="white" opacity="0.6"/>
      <circle cx="68"  cy="50"  r="1.0" fill="white" opacity="0.45"/>
    </pattern>

    <!-- Scanlines (CRT effect) -->
    <pattern id="scanlines" x="0" y="0" width="1920" height="4" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="1920" height="2" fill="black" opacity="0.13"/>
    </pattern>

    <!-- Horizon glow -->
    <linearGradient id="horizglow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="{{P_ACC}}" stop-opacity="0"/>
      <stop offset="60%"  stop-color="{{P_ACC}}" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="{{P_ACC}}" stop-opacity="0.04"/>
    </linearGradient>

    <!-- Ground bottom fade -->
    <linearGradient id="groundfade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color="{{P_BASE}}" stop-opacity="0"/>
      <stop offset="100%" stop-color="{{P_BASE}}" stop-opacity="0.55"/>
    </linearGradient>

    <!-- Clip to grid area -->
    <clipPath id="gridclip">
      <rect x="0" y="556" width="1920" height="524"/>
    </clipPath>
  </defs>

  <!-- Base -->
  <rect width="1920" height="1080" fill="{{P_BASE}}"/>

  <!-- Stars (upper sky only) -->
  <rect x="0" y="0" width="1920" height="580" fill="url(#stars)"/>

  <!-- Horizon glow band -->
  <rect x="0" y="380" width="1920" height="340" fill="url(#horizglow)"/>

  <!-- Retro grid -->
  <g clip-path="url(#gridclip)" fill="none" stroke="{{P_ACC}}">
    <!-- Horizon line -->
    <line x1="0" y1="556" x2="1920" y2="556" stroke-width="2" stroke-opacity="0.9"/>

    <!-- Horizontal lines — geometric spacing toward horizon -->
    <line x1="0" y1="1080" x2="1920" y2="1080" stroke-width="1" stroke-opacity="0.5"/>
    <line x1="0" y1="894"  x2="1920" y2="894"  stroke-width="1" stroke-opacity="0.48"/>
    <line x1="0" y1="776"  x2="1920" y2="776"  stroke-width="1" stroke-opacity="0.44"/>
    <line x1="0" y1="698"  x2="1920" y2="698"  stroke-width="1" stroke-opacity="0.40"/>
    <line x1="0" y1="647"  x2="1920" y2="647"  stroke-width="1" stroke-opacity="0.36"/>
    <line x1="0" y1="614"  x2="1920" y2="614"  stroke-width="1" stroke-opacity="0.30"/>
    <line x1="0" y1="592"  x2="1920" y2="592"  stroke-width="1" stroke-opacity="0.24"/>
    <line x1="0" y1="577"  x2="1920" y2="577"  stroke-width="1" stroke-opacity="0.18"/>
    <line x1="0" y1="567"  x2="1920" y2="567"  stroke-width="1" stroke-opacity="0.12"/>

    <!-- Vertical perspective lines from VP (960, 556) -->
    <line x1="960" y1="556" x2="0"    y2="1080" stroke-width="1" stroke-opacity="0.5"/>
    <line x1="960" y1="556" x2="120"  y2="1080" stroke-width="1" stroke-opacity="0.46"/>
    <line x1="960" y1="556" x2="240"  y2="1080" stroke-width="1" stroke-opacity="0.42"/>
    <line x1="960" y1="556" x2="360"  y2="1080" stroke-width="1" stroke-opacity="0.42"/>
    <line x1="960" y1="556" x2="480"  y2="1080" stroke-width="1" stroke-opacity="0.46"/>
    <line x1="960" y1="556" x2="600"  y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="720"  y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="840"  y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="960"  y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="1080" y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="1200" y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="1320" y2="1080" stroke-width="1" stroke-opacity="0.50"/>
    <line x1="960" y1="556" x2="1440" y2="1080" stroke-width="1" stroke-opacity="0.46"/>
    <line x1="960" y1="556" x2="1560" y2="1080" stroke-width="1" stroke-opacity="0.42"/>
    <line x1="960" y1="556" x2="1680" y2="1080" stroke-width="1" stroke-opacity="0.42"/>
    <line x1="960" y1="556" x2="1800" y2="1080" stroke-width="1" stroke-opacity="0.46"/>
    <line x1="960" y1="556" x2="1920" y2="1080" stroke-width="1" stroke-opacity="0.5"/>
  </g>

  <!-- Ground bottom fade -->
  <rect x="0" y="556" width="1920" height="524" fill="url(#groundfade)"/>

  <!-- Scanlines (full screen) -->
  <rect width="1920" height="1080" fill="url(#scanlines)"/>

  <!-- Accent lines -->
  <rect x="0" y="3"    width="1920" height="1" fill="{{P_ACC}}" opacity="0.25"/>
  <rect x="0" y="1075" width="1920" height="2" fill="{{P_ACC}}" opacity="0.55"/>
</svg>
