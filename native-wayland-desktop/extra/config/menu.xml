<?xml version="1.0" encoding="UTF-8"?>
<!-- Right-click on the wallpaper -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Apps">
      <action name="Execute" command="pkill -USR1 -f native-wayland-desktop-panel.p[y]" />
    </item>
    <item label="File Manager">
      <action name="Execute" command="pcmanfm /userdata" />
    </item>
    <item label="Terminal">
      <action name="Execute" command="xterm -fs 14 -fg white -bg black -fa Monospace -en UTF-8 -sb -rightbar" />
    </item>
    <separator />
    <item label="Change wallpaper">
      <action name="Execute" command="python3 /userdata/system/add-ons/native-wayland-desktop/native-wayland-desktop-panel.py --wallpaper" />
    </item>
    <separator />
    <item label="Back to EmulationStation">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
